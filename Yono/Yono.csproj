<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\Icons\Logo Y.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\Icons\Logo Y.ico" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Assets\Images\" />
    <Folder Include="Core\Helpers\" />
    <Folder Include="Core\Exceptions\" />
    <Folder Include="Core\Base\" />
    <Folder Include="Core\Services\" />
    <Folder Include="Data\Entities\" />
    <Folder Include="Data\Repositories\" />
    <Folder Include="Modules\Main\Models\" />
    <Folder Include="Modules\Personnel\ViewModels\" />
    <Folder Include="Modules\PPE\Models\" />
    <Folder Include="Modules\PPE\ViewModels\" />
    <Folder Include="Modules\PPE\Views\" />
    <Folder Include="Modules\Union\Models\" />
    <Folder Include="Modules\Union\ViewModels\" />
    <Folder Include="Modules\Union\Views\" />
    <Folder Include="Modules\Works\Models\" />
    <Folder Include="Modules\Works\ViewModels\" />
    <Folder Include="Modules\Works\Views\" />
    <Folder Include="Resources\Fonts\" />
    <Folder Include="Resources\Styles\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
